---
import Layout from '../layouts/Layout.astro';
import company from '../data/company.json';
import hero from '../data/hero.json';
import legacy from '../data/legacy.json';
import services from '../data/services.json';
import projects from '../data/projects.json';
import endorsements from '../data/endorsements.json';
import infrastructure from '../data/infrastructure.json';

const base = import.meta.env.BASE_URL;

// Project categories for interactive filtering
const projectCategories: Record<string, string> = {
  "Multipurpose National Identity Card (MNIC) Pilot": "public",
  "Sarva Shiksha Abhiyan Computer Education": "education",
  "Election Photo Identity Card (EPIC) Outsourcing": "public",
  "Rural Banking Computerization": "banking",
  "Hospital Automation System": "healthcare",
  "Long-term Government AMC & Hardware Supply": "public",
  "SSA Household Survey & Minor Irrigation Census": "public"
};
---

<Layout
  title={`${company.name} | Ramanathapuram's Pioneer IT Institution Since 1994`}
  description="Computer Instruments provides enterprise hardware sales, AMC, government data entry, census projects, and computer education across Ramanathapuram district."
>

  <!-- ========================================================================= -->
  <!-- HERO SECTION                                                              -->
  <!-- ========================================================================= -->
  <section class="hero-section">
    <div class="hero-bg-glow"></div>
    <div class="container hero-container">
      <div class="hero-content">
        <!-- Eyebrow Badge -->
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span class="badge-text">{hero.eyebrow}</span>
          <span class="badge-pill">Est. {company.foundedYear}</span>
        </div>

        <!-- Main Title -->
        <h1 class="hero-title">
          <span>{hero.titlePrefix}</span>
          <span class="hero-highlight">{hero.titleHighlight}</span>
        </h1>

        <!-- Tamil Heritage & Motto -->
        <div class="hero-heritage-bar">
          <span class="tamil-script">{company.tamilName}</span>
          <span class="heritage-dot">•</span>
          <span class="motto-quote">"{company.motto}"</span>
        </div>

        <!-- Subtitle -->
        <p class="hero-description">
          {hero.subtitle}
        </p>

        <!-- CTA Buttons -->
        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary hero-btn-main">
            <span>{hero.actions.primary.text}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          <a href="#projects" class="btn btn-dark hero-btn-sub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m12 16 4-4-4-4"/><path d="M8 12h8"/></svg>
            <span>{hero.actions.secondary.text}</span>
          </a>
          <a href={`https://wa.me/${company.whatsapp}`} target="_blank" rel="noopener noreferrer" class="hero-whatsapp-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.456 5.711 1.458h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span>WhatsApp Quick Desk</span>
          </a>
        </div>
      </div>

      <!-- Hero Stats Matrix Card -->
      <div class="hero-stats-panel">
        <div class="stats-panel-glow"></div>
        <div class="stats-panel-header">
          <div class="stats-header-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </div>
          <div>
            <h3 class="stats-panel-title">Institutional Impact</h3>
            <p class="stats-panel-subtitle">Verified district milestones &amp; capacity</p>
          </div>
        </div>

        <div class="stats-items-grid">
          {hero.stats.map((stat) => (
            <div class="hero-stat-card">
              <span class="stat-number">{stat.number}</span>
              <p class="stat-caption">{stat.label}</p>
            </div>
          ))}
          <!-- Social Impact Metric from verified map -->
          <div class="hero-stat-card">
            <span class="stat-number highlight-gold">70%+</span>
            <p class="stat-caption">Differently-abled operators deployed in national BEL pilot</p>
          </div>
        </div>

        <div class="stats-panel-footer">
          <span class="panel-verified-tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Verified District Contractor
          </span>
          <span class="panel-proprietor">{company.proprietor}</span>
        </div>
      </div>
    </div>

    <!-- Trust Marquee / Institutional Strip -->
    <div class="trust-strip">
      <div class="container trust-strip-inner">
        <span class="trust-strip-title">Major Institutional Partnerships &amp; Projects:</span>
        <div class="trust-badges">
          <div class="trust-pill"><span>🏛️</span> Govt. of Tamil Nadu</div>
          <div class="trust-pill"><span>🛡️</span> Bharat Electronics Ltd (BEL)</div>
          <div class="trust-pill"><span>🔬</span> CMFRI Mandapam Camp</div>
          <div class="trust-pill"><span>🗳️</span> Election Commission (EPIC)</div>
          <div class="trust-pill"><span>🏦</span> Indian Bank &amp; Pandiyan Grama Bank</div>
          <div class="trust-pill"><span>🏥</span> Pioneer Hospital (P) Ltd</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SERVICES SECTION (BENTO GRID DESIGN)                                      -->
  <!-- ========================================================================= -->
  <section class="section services-section" id="services">
    <div class="container">
      <div class="section-head">
        <span class="section-eyebrow">{services.tag}</span>
        <h2 class="section-title">{services.heading}</h2>
        <p class="section-desc">
          Providing end-to-end computer infrastructure, large-scale census digitization, reliable AMC support, and technical training with continuous uptime.
        </p>
      </div>

      <div class="services-bento-grid">
        {services.items.map((svc, idx) => (
          <article class={`bento-card bento-card-${idx + 1} card-interactive`}>
            <div class="bento-card-header">
              <div class="svc-icon-wrapper">
                <span class="svc-emoji">{svc.icon}</span>
              </div>
              <span class="svc-number">0{idx + 1}</span>
            </div>
            <div class="bento-card-body">
              <h3 class="svc-title">{svc.title}</h3>
              <p class="svc-description">{svc.description}</p>
            </div>
            <div class="bento-card-footer">
              <a href="#contact" class="svc-action-link">
                <span>Inquire About This Service</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}

        <!-- 6th Bento Card: Custom AMC & SLA Consultation CTA -->
        <article class="bento-card bento-cta-card card-interactive">
          <div class="cta-card-content">
            <div class="cta-pill">INSTITUTIONAL AMC</div>
            <h3 class="cta-title">Need a Custom Maintenance Contract or Technical Audit?</h3>
            <p class="cta-desc">
              We provide tailored on-site Annual Maintenance Contracts (AMC) for government collectorates, hospitals, educational institutions, and enterprises.
            </p>
            <div class="cta-action-wrap">
              <a href="#contact" class="btn btn-primary btn-sm">Schedule Facility Audit</a>
              <a href={`tel:${company.phone}`} class="cta-call-link">Call +91 {company.phoneDisplay}</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- LEGACY & MILESTONES SECTION (INTERACTIVE TIMELINE)                        -->
  <!-- ========================================================================= -->
  <section class="section legacy-section" id="legacy">
    <div class="container">
      <div class="section-head">
        <span class="section-eyebrow gold">{legacy.tag}</span>
        <h2 class="section-title">{legacy.heading}</h2>
        <p class="section-desc">
          From establishing the district's first dual-curriculum IT institute to delivering its earliest dial-up internet and championing inclusive employment for physically disabled youth.
        </p>
      </div>

      <div class="legacy-timeline">
        {legacy.items.map((item, idx) => (
          <div class={`timeline-entry ${idx % 2 === 0 ? 'entry-left' : 'entry-right'}`}>
            <div class="timeline-marker">
              <div class="marker-dot"></div>
              <div class="marker-line"></div>
            </div>
            <div class="timeline-card card-interactive">
              <div class="t-card-header">
                <span class="t-year-tag">{item.date}</span>
                <span class="t-icon">{item.icon}</span>
              </div>
              <h3 class="t-title">{item.title}</h3>
              <p class="t-desc">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- GOVERNMENT & ENTERPRISE PROJECTS SECTION                                  -->
  <!-- ========================================================================= -->
  <section class="section projects-section" id="projects">
    <div class="container">
      <div class="section-head text-left">
        <div class="projects-head-flex">
          <div>
            <span class="section-eyebrow">{projects.tag}</span>
            <h2 class="section-title">{projects.heading}</h2>
          </div>
          <p class="section-desc projects-head-desc">
            Documented public sector and enterprise records demonstrating massive data digitization capability, biometric census experience, and trusted institutional reliability.
          </p>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="project-tabs" role="tablist" aria-label="Project Categories">
        <button class="tab-btn active" data-category="all" role="tab">All Projects ({projects.items.length})</button>
        <button class="tab-btn" data-category="public" role="tab">Government &amp; Census</button>
        <button class="tab-btn" data-category="banking" role="tab">Banking</button>
        <button class="tab-btn" data-category="healthcare" role="tab">Healthcare</button>
        <button class="tab-btn" data-category="education" role="tab">Education</button>
      </div>

      <!-- Projects Grid -->
      <div class="projects-grid" id="projects-grid">
        {projects.items.map((proj) => {
          const category = projectCategories[proj.title] || 'public';
          return (
            <article class="project-card card-interactive" data-category={category}>
              <div class="project-card-top">
                <div class="proj-client-wrap">
                  <span class="client-badge-label">CLIENT / INSTITUTION</span>
                  <h4 class="proj-client">{proj.client}</h4>
                </div>
                <span class="proj-duration-badge">{proj.duration}</span>
              </div>
              <div class="project-card-main">
                <h3 class="proj-title">{proj.title}</h3>
                <p class="proj-desc">{proj.description}</p>
              </div>
              <div class="project-card-bottom">
                <span class="proj-verified-indicator">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  Verified Institutional Record
                </span>
                <a href="#contact" class="proj-contact-link">Inquire Reference →</a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- OFFICIAL RECOGNITION & IAS/IPS LETTERS (LUXURY EXECUTIVE SLATE)           -->
  <!-- ========================================================================= -->
  <section class="section recognition-section" id="endorsements">
    <div class="container">
      <div class="section-head text-center">
        <span class="section-eyebrow gold">{endorsements.tag}</span>
        <h2 class="section-title text-inverse">{endorsements.heading}</h2>
        <p class="section-desc text-inverse-muted">
          Formal citations and certificates awarded by District Collectors, Election Officers, and Central Government Scientists acknowledging institutional dedication and flawless execution.
        </p>
      </div>

      <div class="recognition-grid">
        {endorsements.items.map((item) => (
          <div class="endorse-item-card">
            <div class="quote-symbol" aria-hidden="true">“</div>
            <blockquote class="endorse-quote">
              {item.quote}
            </blockquote>
            <div class="endorse-signatory">
              <div class="official-crest">
                <span class="crest-letters">{item.initials}</span>
              </div>
              <div class="official-meta">
                <strong class="official-name">{item.name}</strong>
                <p class="official-desg">{item.designation}</p>
                <span class="official-date">{item.date}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- INFRASTRUCTURE & OPERATIONAL CAPACITY COMMAND CENTER                      -->
  <!-- ========================================================================= -->
  <section class="section infra-section" id="infra">
    <div class="container">
      <div class="section-head">
        <span class="section-eyebrow">{infrastructure.tag}</span>
        <h2 class="section-title">{infrastructure.heading}</h2>
        <p class="section-desc">
          State-of-the-art laboratory, high-density power stabilization, printing stations, and certified technical manpower ready for rapid deployment.
        </p>
      </div>

      <div class="infra-dual-grid">
        <!-- Facilities & Equipment Column -->
        <div class="infra-col card-interactive">
          <div class="infra-col-header">
            <div class="infra-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
            </div>
            <div>
              <h3 class="infra-col-title">{infrastructure.facilitySubtitle}</h3>
              <p class="infra-col-desc">Hardware, lab space, power redundancy, and statutory details</p>
            </div>
          </div>

          <div class="specs-table">
            {infrastructure.specs.map(spec => (
              <div class="spec-item-row">
                <span class="spec-name">{spec.label}</span>
                <span class="spec-data">{spec.value}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Team & Certified Manpower Column -->
        <div class="infra-col card-interactive">
          <div class="infra-col-header">
            <div class="infra-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
              <h3 class="infra-col-title">{infrastructure.teamSubtitle} &amp; Field Staff</h3>
              <p class="infra-col-desc">Qualified engineering and certified data processing workforce</p>
            </div>
          </div>

          <div class="team-cards-grid">
            {infrastructure.team.map(cell => (
              <div class="team-role-card">
                <span class="team-count">{cell.count}</span>
                <span class="team-role">{cell.role}</span>
              </div>
            ))}
          </div>

          <!-- Total Staff Highlight Banner -->
          <div class="total-staff-highlight">
            <div class="total-staff-badge">
              <span class="total-staff-num">{infrastructure.totalStaff.count}</span>
              <div>
                <strong>Certified Staff Members</strong>
                <p>{infrastructure.totalStaff.role}</p>
              </div>
            </div>
            <a href="#contact" class="btn btn-primary btn-sm">Request Staff Deployment</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- HARDWARE PRODUCTS PREVIEW BANNER                                          -->
  <!-- ========================================================================= -->
  <section class="products-cta-section">
    <div class="container">
      <div class="products-cta-box">
        <div class="p-cta-text">
          <span class="p-cta-eyebrow">HARDWARE STORE &amp; WORKSTATIONS</span>
          <h2 class="p-cta-title">Explore Our Computer Hardware &amp; Custom Rig Inventory</h2>
          <p class="p-cta-desc">
            We assemble and supply Intel Core i7 &amp; i5 workstation towers, commercial desktops, network hardware, and peripherals with full on-site warranty in Ramanathapuram.
          </p>
        </div>
        <div class="p-cta-btn-wrap">
          <a href={`${base}products/`} class="btn btn-gold">
            <span>Browse Products Catalogue</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- CONTACT & SERVICE DESK SECTION                                            -->
  <!-- ========================================================================= -->
  <section class="section contact-section" id="contact">
    <div class="container">
      <div class="section-head text-left">
        <span class="section-eyebrow">Direct Service Desk</span>
        <h2 class="section-title">Reach Out for AMC, Government Projects, or Hardware</h2>
        <p class="section-desc">
          Get in touch with proprietor Thiru. D. Ramprakash, B.E., or our technical engineering staff for service quotations and contract proposals.
        </p>
      </div>

      <div class="contact-dual-container">
        <!-- Interactive Enquiry Form -->
        <div class="contact-form-panel card-interactive">
          <h3 class="form-title">Send a Service Inquiry</h3>
          <p class="form-desc">Fill out your requirement and we will respond immediately via telephone or email.</p>

          <form id="enquiry-form" class="enquiry-form">
            <div class="form-row-2">
              <div class="form-group">
                <label for="name">Your Name / Title *</label>
                <input type="text" id="name" name="name" placeholder="Thiru. / Dr. / Officer Name" required />
              </div>
              <div class="form-group">
                <label for="phone">Mobile / Contact Phone *</label>
                <input type="tel" id="phone" name="phone" placeholder="10-digit mobile number" required />
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label for="org">Department / Institution / Business</label>
                <input type="text" id="org" name="org" placeholder="Government Dept, Bank, Hospital, etc." />
              </div>
              <div class="form-group">
                <label for="service">Service Required *</label>
                <select id="service" name="service" required>
                  <option value="">Select a service category</option>
                  <option value="Hardware Sales & AMC">Hardware Sales &amp; On-Site AMC</option>
                  <option value="Data Entry & Digitization">Data Entry &amp; Document Digitization</option>
                  <option value="IT Manpower Outsourcing">IT Manpower Outsourcing</option>
                  <option value="Custom Software Development">Custom Software Development</option>
                  <option value="Hardware & Software Training">Computer Education &amp; Training</option>
                  <option value="General Hardware Inquiry">General Hardware / Product Inquiry</option>
                  <option value="Other">Other Specific Requirement</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="message">Detailed Requirement</label>
              <textarea id="message" name="message" rows="4" placeholder="Briefly describe your hardware requirement, AMC timeline, or digitization scope..."></textarea>
            </div>

            <div class="form-actions-bar">
              <button type="submit" class="btn btn-primary btn-submit">
                <span>Submit Service Enquiry</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </button>
              <a
                id="whatsapp-submit-btn"
                href={`https://wa.me/${company.whatsapp}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-secondary btn-whatsapp-direct"
              >
                <span>Chat Instantly on WhatsApp</span>
              </a>
            </div>

            <div id="form-thanks" class="form-success-banner" style="display: none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span>Thank you! Your mail application has been prepared with your inquiry details.</span>
            </div>
          </form>
        </div>

        <!-- Office Details & Direct Channels -->
        <div class="contact-details-panel">
          <div class="office-card card-interactive">
            <h3 class="oc-title">Registered Office Address</h3>
            <address class="oc-address">
              <strong>{company.name}</strong><br />
              {company.address.line1}<br />
              {company.address.city} – {company.address.pincode}<br />
              {company.address.state}, India
            </address>

            <div class="oc-meta-row">
              <div class="oc-meta-item">
                <span class="meta-label">Primary Desk</span>
                <a href={`tel:${company.phone}`} class="meta-val phone-link">+91 {company.phoneDisplay}</a>
              </div>
              <div class="oc-meta-item">
                <span class="meta-label">Alternate Desk</span>
                <a href={`tel:${company.alternatePhone}`} class="meta-val phone-link">+91 {company.alternatePhone}</a>
              </div>
            </div>

            <div class="oc-meta-item full-width">
              <span class="meta-label">Official Email</span>
              <a href={`mailto:${company.email}`} class="meta-val email-link">{company.email}</a>
            </div>

            <div class="oc-historical-note">
              <span class="hist-label">Historical Office (1998–2016):</span>
              <p class="hist-text">{company.previousAddress.full} {company.previousAddress.duration}</p>
            </div>

            <!-- Google Maps Quick Directions Button -->
            <a
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(company.address.full)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary oc-map-btn"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>Open in Google Maps</span>
            </a>
          </div>

          <!-- Statutory Compliance Card -->
          <div class="statutory-card card-interactive">
            <h4 class="st-title">Statutory Legal Credentials</h4>
