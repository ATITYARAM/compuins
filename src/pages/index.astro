---
import company from '../data/company.json';
import hero from '../data/hero.json';
import legacy from '../data/legacy.json';
import services from '../data/services.json';
import projects from '../data/projects.json';
import endorsements from '../data/endorsements.json';
import infrastructure from '../data/infrastructure.json';
import navigation from '../data/navigation.json';
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{company.name} | {company.historicalName} — {company.address.city}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
<style>
  :root {
    --maroon: #800000;
    --maroon-dark: #5a0000;
    --maroon-light: #a01010;
    --gold: #D4AF37;
    --gold-pale: #f0d97a;
    --cream: #fdf8f0;
    --ink: #1a1208;
    --ink-mid: #3d2e14;
    --ink-soft: #6b5740;
    --rule: #d6c5a8;
    --bg: #ffffff;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; font-size: 16px; }
  body { font-family: 'IBM Plex Sans', sans-serif; background: var(--bg); color: var(--ink); line-height: 1.6; }
  h1, h2, h3, .serif { font-family: 'Libre Baskerville', Georgia, serif; }
  h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1.2; font-weight: 700; }
  h3 { font-size: 1.25rem; font-weight: 700; line-height: 1.3; }
  p { max-width: 68ch; }
  .container { max-width: 1160px; margin: 0 auto; padding: 0 1.5rem; }
  .rule { border: none; border-top: 1px solid var(--rule); }
  .gold-accent { color: var(--gold); }
  .maroon-accent { color: var(--maroon); }
  .tag { display: inline-block; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--maroon); border: 1px solid var(--maroon); padding: 0.15rem 0.55rem; border-radius: 2px; margin-bottom: 0.75rem; }
  nav { position: sticky; top: 0; z-index: 100; background: rgba(255,255,255,0.95); backdrop-filter: blur(8px); border-bottom: 2px solid var(--maroon); }
  .nav-inner { display: flex; align-items: center; gap: 2rem; padding: 0.85rem 1.5rem; max-width: 1160px; margin: 0 auto; }
  .ci-badge { width: 42px; height: 42px; background: var(--maroon); display: flex; align-items: center; justify-content: center; border-radius: 4px; flex-shrink: 0; }
  .ci-badge span { font-family: 'Libre Baskerville', serif; color: var(--gold); font-size: 1.1rem; font-weight: 700; letter-spacing: -0.03em; }
  .nav-brand { display: flex; flex-direction: column; line-height: 1.1; }
  .nav-brand strong { font-family: 'Libre Baskerville', serif; font-size: 0.95rem; color: var(--ink); }
  .nav-brand small { font-size: 0.7rem; color: var(--ink-soft); font-weight: 400; }
  .nav-links { display: flex; gap: 1.5rem; margin-left: auto; list-style: none; }
  .nav-links a { font-size: 0.82rem; font-weight: 500; text-decoration: none; color: var(--ink-mid); transition: color 0.2s; }
  .nav-links a:hover { color: var(--maroon); }
  .nav-cta { background: var(--maroon); color: white; padding: 0.5rem 1.1rem; border-radius: 3px; font-size: 0.82rem; font-weight: 600; text-decoration: none; white-space: nowrap; flex-shrink: 0; transition: background 0.2s; }
  .nav-cta:hover { background: var(--maroon-dark); }
  .hero { background: var(--cream); border-bottom: 1px solid var(--rule); padding: 5rem 1.5rem 4rem; }
  .hero-inner { max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: 1fr 340px; gap: 4rem; align-items: center; }
  .hero-eyebrow { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
  .hero-eyebrow::before { content: ''; display: block; width: 28px; height: 2px; background: var(--gold); }
  .hero h1 { font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 1.08; color: var(--ink); margin-bottom: 0.3rem; }
  .hero h1 em { font-style: italic; color: var(--maroon); }
  .hero-sub { font-size: 1.05rem; color: var(--ink-soft); margin: 1.25rem 0 2rem; max-width: 52ch; }
  .hero-tamil { font-size: 1.3rem; color: var(--maroon); font-weight: 400; margin-bottom: 0.4rem; }
  .hero-motto { font-family: 'Libre Baskerville', serif; font-style: italic; color: var(--ink-soft); font-size: 1rem; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .btn-primary { background: var(--maroon); color: white; padding: 0.75rem 1.75rem; border-radius: 3px; font-size: 0.9rem; font-weight: 600; text-decoration: none; transition: background 0.2s; }
  .btn-primary:hover { background: var(--maroon-dark); }
  .btn-ghost { color: var(--maroon); font-size: 0.9rem; font-weight: 500; text-decoration: none; border-bottom: 1px solid var(--maroon); padding-bottom: 1px; }
  .hero-stats { background: var(--maroon); border-radius: 6px; padding: 2rem; color: white; display: flex; flex-direction: column; gap: 1.5rem; }
  .stat-item { border-bottom: 1px solid rgba(255,255,255,0.15); padding-bottom: 1.5rem; }
  .stat-item:last-child { border-bottom: none; padding-bottom: 0; }
  .stat-num { font-family: 'Libre Baskerville', serif; font-size: 2.8rem; line-height: 1; color: var(--gold); font-weight: 700; }
  .stat-label { font-size: 0.82rem; color: rgba(255,255,255,0.7); margin-top: 0.2rem; }
  section { padding: 5rem 1.5rem; }
  .section-header { margin-bottom: 3rem; }
  .section-header h2 { margin-top: 0.4rem; }
  .legacy { background: var(--bg); }
  .legacy-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid var(--rule); border-radius: 4px; overflow: hidden; }
  .legacy-feature { padding: 2.5rem; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .legacy-feature:nth-child(even) { border-right: none; }
  .legacy-feature:nth-last-child(-n+2) { border-bottom: none; }
  .legacy-icon { width: 44px; height: 44px; background: var(--cream); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; font-size: 1.3rem; }
  .legacy-feature h3 { margin-bottom: 0.5rem; font-size: 1.1rem; }
  .legacy-feature p { font-size: 0.88rem; color: var(--ink-soft); max-width: 38ch; }
  .year-pill { display: inline-block; font-size: 0.72rem; font-weight: 600; background: var(--gold); color: var(--ink); padding: 0.1rem 0.5rem; border-radius: 2px; margin-bottom: 0.5rem; }
  .services { background: var(--cream); }
  .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5px; background: var(--rule); border: 1.5px solid var(--rule); border-radius: 4px; overflow: hidden; }
  .service-card { background: var(--cream); padding: 2rem; transition: background 0.2s; }
  .service-card:hover { background: #fff; }
  .svc-icon { font-size: 1.6rem; margin-bottom: 1rem; }
  .service-card h3 { font-size: 1rem; margin-bottom: 0.5rem; }
  .service-card p { font-size: 0.85rem; color: var(--ink-soft); max-width: 34ch; }
  .projects { background: var(--bg); }
  .projects-list { display: flex; flex-direction: column; gap: 0; border: 1px solid var(--rule); border-radius: 4px; overflow: hidden; }
  .project-row { display: grid; grid-template-columns: 220px 1fr; border-bottom: 1px solid var(--rule); }
  .project-row:last-child { border-bottom: none; }
  .proj-meta { background: var(--cream); padding: 1.75rem 1.5rem; border-right: 1px solid var(--rule); }
  .proj-meta .client-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-soft); margin-bottom: 0.3rem; }
  .proj-meta .client-name { font-weight: 600; font-size: 0.85rem; color: var(--ink); line-height: 1.3; }
  .proj-meta .proj-year { font-family: 'Libre Baskerville', serif; color: var(--maroon); font-size: 0.9rem; margin-top: 0.4rem; }
  .proj-body { padding: 1.75rem 2rem; }
  .proj-body h3 { font-size: 1rem; margin-bottom: 0.4rem; }
  .proj-body p { font-size: 0.85rem; color: var(--ink-soft); max-width: 60ch; }
  .endorsements { background: var(--maroon); padding: 5rem 1.5rem; }
  .endorsements .section-header h2 { color: white; }
  .endorsements .section-header .tag { color: var(--gold); border-color: var(--gold); }
  .endorsements-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .endorse-card { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15); border-radius: 4px; padding: 2rem; }
  .endorse-card blockquote { font-family: 'Libre Baskerville', serif; font-style: italic; font-size: 0.95rem; line-height: 1.65; color: rgba(255,255,255,0.9); margin-bottom: 1.25rem; max-width: 52ch; }
  .endorse-official { display: flex; align-items: center; gap: 0.85rem; }
  .official-badge { width: 36px; height: 36px; background: var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--maroon-dark); font-size: 0.85rem; flex-shrink: 0; }
  .official-info .name { font-weight: 600; color: white; font-size: 0.88rem; }
  .official-info .desg { font-size: 0.77rem; color: rgba(255,255,255,0.6); line-height: 1.3; }
  .official-info .date { font-size: 0.73rem; color: var(--gold); margin-top: 0.1rem; }
  .infra { background: var(--cream); }
  .infra-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
  .infra-specs { display: flex; flex-direction: column; gap: 1rem; }
  .spec-row { display: flex; justify-content: space-between; align-items: baseline; padding: 0.65rem 0; border-bottom: 1px solid var(--rule); }
  .spec-row:last-child { border-bottom: none; }
  .spec-label { font-size: 0.85rem; color: var(--ink-soft); }
  .spec-val { font-weight: 600; font-size: 0.9rem; color: var(--ink); text-align: right; }
  .staff-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .staff-cell { background: white; border: 1px solid var(--rule); border-radius: 3px; padding: 1rem; }
  .staff-cell .num { font-family: 'Libre Baskerville', serif; font-size: 1.8rem; color: var(--maroon); line-height: 1; }
  .staff-cell .role { font-size: 0.78rem; color: var(--ink-soft); margin-top: 0.2rem; }
  .contact { background: var(--bg); }
  .contact-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }
  .contact-form { display: flex; flex-direction: column; gap: 1rem; }
  .form-field label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--ink-mid); margin-bottom: 0.35rem; }
  .form-field input, .form-field textarea, .form-field select { width: 100%; border: 1px solid var(--rule); background: var(--cream); padding: 0.65rem 0.85rem; border-radius: 3px; font-family: 'IBM Plex Sans', sans-serif; font-size: 0.88rem; color: var(--ink); outline: none; transition: border-color 0.2s; }
  .form-field input:focus, .form-field textarea:focus, .form-field select:focus { border-color: var(--maroon); }
  .form-field textarea { height: 110px; resize: vertical; }
  .btn-submit { background: var(--maroon); color: white; padding: 0.75rem 2rem; border: none; border-radius: 3px; font-size: 0.9rem; font-weight: 600; cursor: pointer; align-self: flex-start; font-family: inherit; transition: background 0.2s; }
  .btn-submit:hover { background: var(--maroon-dark); }
  .contact-info { display: flex; flex-direction: column; gap: 2rem; }
  .info-block h3 { font-size: 0.9rem; margin-bottom: 0.5rem; color: var(--ink-mid); }
  .info-block p, .info-block address { font-style: normal; font-size: 0.88rem; color: var(--ink-soft); line-height: 1.7; }
  .info-block a { color: var(--maroon); text-decoration: none; }
  .legal-ids { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .legal-id { font-size: 0.78rem; }
  .legal-id span { font-weight: 600; color: var(--ink); }
  footer { background: var(--ink); color: rgba(255,255,255,0.5); padding: 2rem 1.5rem; text-align: center; font-size: 0.8rem; }
  footer strong { color: rgba(255,255,255,0.8); }
  @media (max-width: 768px) {
    .nav-links { display: none; }
    .hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero-stats { flex-direction: row; flex-wrap: wrap; }
    .stat-item { flex: 1; min-width: 120px; border-bottom: none; padding-bottom: 0; border-right: 1px solid rgba(255,255,255,0.15); }
    .stat-item:last-child { border-right: none; }
    .legacy-grid { grid-template-columns: 1fr; }
    .legacy-feature { border-right: none !important; }
    .services-grid { grid-template-columns: 1fr; gap: 0; }
    .project-row { grid-template-columns: 1fr; }
    .proj-meta { border-right: none; border-bottom: 1px solid var(--rule); }
    .endorsements-grid { grid-template-columns: 1fr; }
    .infra-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .contact-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .legal-ids { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
</head>
<body>
<nav>
  <div class="nav-inner">
    <div class="ci-badge"><span>CI</span></div>
    <div class="nav-brand">
      <strong>{company.name}</strong>
      <small>{company.historicalName} · Est. {company.foundedYear}</small>
    </div>
    <ul class="nav-links">
      {navigation.links.map(link => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <a href={`tel:${company.phone}`} class="nav-cta">📞 {company.phoneDisplay}</a>
  </div>
</nav>
<section class="hero">
  <div class="hero-inner">
    <div class="hero-left">
      <div class="hero-eyebrow">{hero.eyebrow}</div>
      <h1>{hero.titlePrefix}<br><em>{hero.titleHighlight}</em></h1>
      <div class="hero-tamil">{company.tamilName}</div>
      <p class="hero-motto">"{company.motto}"</p>
      <p class="hero-sub">{hero.subtitle}</p>
      <div class="hero-actions">
        <a href={hero.actions.primary.href} class="btn-primary">{hero.actions.primary.text}</a>
        <a href={hero.actions.secondary.href} class="btn-ghost">{hero.actions.secondary.text}</a>
      </div>
    </div>
    <div class="hero-stats">
      {hero.stats.map(stat => (
        <div class="stat-item"><div class="stat-num">{stat.number}</div><div class="stat-label">{stat.label}</div></div>
      ))}
    </div>
  </div>
</section>
<section class="legacy" id="legacy">
  <div class="container">
    <div class="section-header"><span class="tag">{legacy.tag}</span><h2>{legacy.heading.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2></div>
    <div class="legacy-grid">
      {legacy.items.map(item => (
        <div class="legacy-feature"><div class="year-pill">{item.date}</div><div class="legacy-icon">{item.icon}</div><h3>{item.title}</h3><p>{item.description}</p></div>
      ))}
    </div>
  </div>
</section>
<section class="services" id="services">
  <div class="container"><div class="section-header"><span class="tag">{services.tag}</span><h2>{services.heading.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2></div><div class="services-grid">
    {services.items.map(item => (
      <div class="service-card"><div class="svc-icon">{item.icon}</div><h3>{item.title}</h3><p>{item.description}</p></div>
    ))}
  </div></div>
</section>
<section class="projects" id="projects">
  <div class="container"><div class="section-header"><span class="tag">{projects.tag}</span><h2>{projects.heading.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2></div><div class="projects-list">
    {projects.items.map(proj => (
      <div class="project-row"><div class="proj-meta"><div class="client-label">Client</div><div class="client-name">{proj.client}</div><div class="proj-year">{proj.duration}</div></div><div class="proj-body"><h3>{proj.title}</h3><p>{proj.description}</p></div></div>
    ))}
  </div></div>
</section>
<section class="endorsements" id="endorsements">
  <div class="container"><div class="section-header"><span class="tag">{endorsements.tag}</span><h2>{endorsements.heading.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2></div><div class="endorsements-grid">
    {endorsements.items.map(endorse => (
      <div class="endorse-card"><blockquote>"{endorse.quote}"</blockquote><div class="endorse-official"><div class="official-badge">{endorse.initials}</div><div class="official-info"><div class="name">{endorse.name}</div><div class="desg">{endorse.designation}</div><div class="date">{endorse.date}</div></div></div></div>
    ))}
  </div></div>
</section>
<section class="infra" id="infra">
  <div class="container"><div class="section-header"><span class="tag">{infrastructure.tag}</span><h2>{infrastructure.heading.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2></div><div class="infra-inner">
    <div><h3 style="margin-bottom:1.25rem;font-size:1rem;color:var(--ink-soft);font-weight:500;">{infrastructure.facilitySubtitle}</h3><div class="infra-specs">
      {infrastructure.specs.map(spec => (
        <div class="spec-row"><span class="spec-label">{spec.label}</span><span class="spec-val">{spec.value}</span></div>
      ))}
    </div></div>
    <div><h3 style="margin-bottom:1.25rem;font-size:1rem;color:var(--ink-soft);font-weight:500;">{infrastructure.teamSubtitle}</h3><div class="staff-grid">
      {infrastructure.team.map(cell => (
        <div class="staff-cell"><div class="num">{cell.count}</div><div class="role">{cell.role}</div></div>
      ))}
      <div class="staff-cell" style="grid-column: span 2;"><div class="num" style="color:var(--maroon);">{infrastructure.totalStaff.count}</div><div class="role">{infrastructure.totalStaff.role}</div></div>
    </div></div>
  </div></div>
</section>
<section class="contact" id="contact" style="border-top:1px solid var(--rule);">
  <div class="container"><div class="section-header"><span class="tag">Contact Us</span><h2>Reach out for AMC,<br>projects, or training</h2></div><div class="contact-inner">
    <form class="contact-form" id="enquiry-form"><div class="form-field"><label for="name">Your Name</label><input type="text" id="name" name="name" placeholder="Thiru. / Dr. / Name" required /></div><div class="form-field"><label for="org">Organisation</label><input type="text" id="org" name="org" placeholder="Government dept, institution, company" /></div><div class="form-field"><label for="phone">Phone Number</label><input type="tel" id="phone" name="phone" placeholder="10-digit mobile number" required /></div><div class="form-field"><label for="service">Service Required</label><select id="service" name="service"><option value="">Select a service</option><option>Hardware Sales &amp; AMC</option><option>Data Entry &amp; Digitization</option><option>IT Manpower Outsourcing</option><option>Custom Software Development</option><option>Computer Education / Training</option><option>Other</option></select></div><div class="form-field"><label for="message">Message</label><textarea id="message" name="message" placeholder="Describe your requirement briefly…"></textarea></div><button type="submit" class="btn-submit">Send Enquiry</button><div id="form-thanks" style="display:none;font-size:0.88rem;color:var(--maroon);font-weight:500;">Thank you — opening your mail client...</div></form>
    <div class="contact-info"><div class="info-block"><h3>Current Office</h3><address>{company.address.line1}<br>{company.address.city}, {company.address.state} — {company.address.pincode}</address></div><div class="info-block"><h3>Phone</h3><p><a href={`tel:${company.phone}`}>{company.phoneDisplay}</a></p></div><div class="info-block"><h3>Previous Address</h3><p style="font-size:0.82rem;color:var(--ink-soft);">{company.previousAddress.full}<br><span style="font-size:0.75rem;opacity:0.7;">{company.previousAddress.duration}</span></p></div><div class="info-block"><h3>Legal Identifiers</h3><div class="legal-ids"><div class="legal-id">GST<br><span>{company.legalIds.gst}</span></div><div class="legal-id">PAN<br><span>{company.legalIds.pan}</span></div><div class="legal-id" style="grid-column:span 2;">TN VAT<br><span>{company.legalIds.tnVat}</span></div></div></div></div>
  </div></div>
</section>
<footer><p><strong>{company.name} / {company.historicalName}</strong><br>Proprietor: {company.proprietor} · Est. {company.foundedYear}, Registered {company.registeredYear}<br>{company.address.full}<br>GST {company.legalIds.gst} · PAN {company.legalIds.pan}</p></footer>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('enquiry-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('name').value.trim() || 'N/A';
        const org = document.getElementById('org').value.trim() || 'N/A';
        const phone = document.getElementById('phone').value.trim() || 'N/A';
        const service = document.getElementById('service').value || 'Not specified';
        const message = document.getElementById('message').value.trim() || 'No message provided';
        const recipient = 'enquiry@compuins.com';
        const subject = encodeURIComponent('ENQUIRY');
        const bodyText = `Hello Computer Instruments,\n\n` + `Here are the details of my enquiry:\n\n` + `• Name: ${name}\n` + `• Organisation: ${org}\n` + `• Phone Number: ${phone}\n` + `• Service Required: ${service}\n\n` + `• Message:\n${message}\n\n` + `Regards,\n${name}`;
        window.location.href = `mailto:${recipient}?subject=${subject}&body=${encodeURIComponent(bodyText)}`;
        const thanks = document.getElementById('form-thanks');
        if (thanks) thanks.style.display = 'block';
        e.target.reset();
      });
    }
  });
</script>
</body>
</html>