---
import Layout from '../layouts/Layout.astro';
import company from '../data/company.json';
import legacy from '../data/legacy.json';
import hero from '../data/hero.json';

const base = import.meta.env.BASE_URL;
---

<Layout
  title={`About Us & Institutional History | ${company.name}`}
  description={`Discover the 30-year legacy of Computer Instruments (Computer Informatics, est. 1994) in Ramanathapuram, founded by Thiru. D. Ramprakash, B.E.`}
>
  <!-- Page Header -->
  <section class="about-hero">
    <div class="container">
      <div class="about-hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>ESTABLISHED 12 JUNE 1994 • RAMANATHAPURAM</span>
        </div>
        <h1 class="about-title">
          Thirty Years of <span class="text-gradient-blue">Institutional IT Trust</span>
        </h1>
        <p class="about-subtitle">
          From pioneering personal computing education and district-first internet in 1998 to delivering mission-critical government biometrics and multi-decade AMC contracts.
        </p>
      </div>
    </div>
  </section>

  <!-- The Founding Story -->
  <section class="section">
    <div class="container">
      <div class="story-grid">
        <div class="story-text">
          <span class="section-eyebrow">Founding Vision</span>
          <h2 class="section-title">Built on Engineering Discipline &amp; Public Purpose</h2>
          <p class="lead-p">
            On <strong>12 June 1994</strong>, <strong>Thiru. D. Ramprakash, B.E.</strong>, founded <em>Computer Informatics</em> in Ramanathapuram, offering comprehensive computer hardware and software education when personal computing was virtually unknown in the district.
          </p>
          <p>
            Operating originally from <strong>159, Salai Street (1998 to 2016)</strong> and subsequently expanding commercial services as <strong>Computer Instruments</strong> (registered on 1 December 1997), the institution set an enduring standard: <em>"{company.motto}"</em>.
          </p>
          <p>
            In 1998, Computer Instruments established Ramanathapuram's first internet link to Chennai via STD facilities, conducting public awareness seminars that introduced local youth, educators, and businesses to the digital information age.
          </p>
          
          <div class="proprietor-card">
            <div class="p-avatar">
              <span>DR</span>
            </div>
            <div>
              <strong class="p-name">{company.proprietor}</strong>
              <p class="p-title">Proprietor &amp; Chief Engineer</p>
              <p class="p-note">Son of M. Danapalan · Graduate in Engineering (B.E.)</p>
            </div>
          </div>
        </div>

        <div class="story-metrics-panel card-interactive">
          <h3 class="panel-heading">Key Institutional Milestones</h3>
          
          <div class="milestone-list">
            <div class="milestone-row">
              <span class="m-date">12 June 1994</span>
              <div>
                <strong>Computer Informatics Promoted</strong>
                <p>First dual-discipline computer hardware &amp; software training centre in Ramanathapuram.</p>
              </div>
            </div>

            <div class="milestone-row">
              <span class="m-date">01 Dec 1997</span>
              <div>
                <strong>Computer Instruments Registered</strong>
                <p>Commercial registration for hardware sales, AMC, and large-scale data digitization contracts.</p>
              </div>
            </div>

            <div class="milestone-row">
              <span class="m-date">1998</span>
              <div>
                <strong>District's First Internet Connection</strong>
                <p>Connected via Chennai STD network; organized district-wide public internet seminars.</p>
              </div>
            </div>

            <div class="milestone-row">
              <span class="m-date">1998 – Present</span>
              <div>
                <strong>Government AMC Partnerships</strong>
                <p>Continuous annual maintenance for Joint Director of Agriculture, CMFRI Mandapam Camp, and Collectorate.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Mission & Differently-Abled Empowerment -->
  <section class="section social-mission-section">
    <div class="container">
      <div class="social-box card-interactive">
        <div class="social-header">
          <span class="social-pill">SOCIAL COMMITMENT</span>
          <h2 class="social-title">Inclusive IT Training &amp; Differently-Abled Empowerment</h2>
          <p class="social-desc">
            A hallmark of Computer Instruments' history has been an unyielding commitment to empowering rural, economically backward, and physically challenged individuals with productive digital livelihoods.
          </p>
        </div>

        <div class="social-highlights-grid">
          <div class="social-card">
            <div class="sc-icon">♿</div>
            <h3>Dedicated Training Branch</h3>
            <p>
              Established a specialized branch inside the Ramanathapuram Collectorate complex dedicated to training physically challenged youth in computer operations, photocopying, and data conversion.
            </p>
          </div>

          <div class="social-card">
            <div class="sc-icon">🛡️</div>
            <h3>BEL MNIC Pilot Milestone</h3>
            <p>
              During the 2½-year national Multipurpose National Identity Card pilot under Bharat Electronics Limited (BEL), more than <strong>70% of operators deployed were differently-abled persons</strong> trained by our institution.
            </p>
          </div>

          <div class="social-card">
            <div class="sc-icon">🎓</div>
            <h3>SSA Rural Digital Literacy</h3>
            <p>
              Delivered hands-on computer education to <strong>more than 2,000 rural students</strong> of Classes 6, 7, and 8 across the Bogalur educational block under Sarva Shiksha Abhiyan.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline Cards from legacy.json -->
  <section class="section">
    <div class="container">
      <div class="section-head text-center">
        <span class="section-eyebrow">Documented Records</span>
        <h2 class="section-title">Verified Historical Milestones</h2>
        <p class="section-desc">Extracted from original appreciation records, government orders, and institutional archives.</p>
      </div>

      <div class="milestones-grid">
        {legacy.items.map(item => (
          <article class="milestone-card card-interactive">
            <div class="m-card-top">
              <span class="m-badge">{item.date}</span>
              <span class="m-emoji">{item.icon}</span>
            </div>
            <h3 class="m-heading">{item.title}</h3>
            <p class="m-body">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Bar -->
  <section class="about-cta-bar">
    <div class="container cta-flex">
      <div>
        <h2>Ready to collaborate on IT infrastructure or enterprise AMC?</h2>
        <p>Get in touch with our technical team today.</p>
      </div>
      <div class="cta-actions">
        <a href={`${base}#contact`} class="btn btn-primary">Submit Service Enquiry</a>
        <a href={`${base}products/`} class="btn btn-secondary">Browse Hardware Products</a>
      </div>
    </div>
  </section>

  <style>
    .about-hero {
      background: linear-gradient(135deg, #070b14 0%, #0b1120 50%, #101c38 100%);
      color: #ffffff;
      padding: 5.5rem 0 4.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .about-hero-content {
      max-width: 820px;
    }
    .about-title {
      font-size: clamp(2.4rem, 4vw, 3.6rem);
      margin: 1rem 0;
      color: #ffffff;
      line-height: 1.1;
    }
    .about-subtitle {
      font-size: 1.15rem;
      color: #cbd5e1;
      line-height: 1.7;
    }

    .story-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 3.5rem;
      align-items: start;
    }
    @media (max-width: 900px) {
      .story-grid {
        grid-template-columns: 1fr;
      }
    }
    .lead-p {
      font-size: 1.1rem;
      color: var(--text-main);
      margin-bottom: 1.25rem;
    }
    .story-text p {
      margin-bottom: 1.25rem;
      line-height: 1.7;
    }
    .proprietor-card {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      background: var(--primary-subtle);
      border: 1px solid rgba(59, 130, 246, 0.25);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      margin-top: 2rem;
    }
    .p-avatar {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: var(--primary);
      color: #ffffff;
      font-weight: 800;
      font-size: 1.2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .p-name {
      font-size: 1.1rem;
      color: var(--primary-dark);
      display: block;
    }
    .p-title {
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    .p-note {
      font-size: 0.78rem;
      color: var(--slate-500);
      margin-top: 0.2rem;
    }

    /* Metrics Panel */
    .story-metrics-panel {
      padding: 2.25rem;
      background: #ffffff;
    }
    .panel-heading {
      font-size: 1.25rem;
      margin-bottom: 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border-light);
    }
    .milestone-list {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .milestone-row {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .m-date {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--primary);
      background: var(--primary-subtle);
      padding: 0.15rem 0.5rem;
      border-radius: var(--radius-sm);
      align-self: flex-start;
    }
    .milestone-row strong {
      font-size: 0.95rem;
      color: var(--text-main);
    }
    .milestone-row p {
      font-size: 0.85rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* Social Mission Box */
    .social-mission-section {
      background: var(--slate-100);
    }
    .social-box {
      background: #ffffff;
      padding: 3.5rem;
    }
    @media (max-width: 768px) {
      .social-box {
        padding: 2rem 1.5rem;
      }
    }
    .social-header {
      max-width: 760px;
      margin-bottom: 2.5rem;
    }
    .social-pill {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--gold);
      background: var(--gold-subtle);
      padding: 0.2rem 0.65rem;
      border-radius: var(--radius-full);
      display: inline-block;
      margin-bottom: 0.75rem;
    }
    .social-title {
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      margin-bottom: 0.75rem;
    }
    .social-desc {
      font-size: 1rem;
      color: var(--text-muted);
    }
    .social-highlights-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
    @media (max-width: 900px) {
      .social-highlights-grid {
        grid-template-columns: 1fr;
      }
    }
    .social-card {
      background: var(--slate-50);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      padding: 1.75rem;
    }
    .sc-icon {
      font-size: 2rem;
      margin-bottom: 0.75rem;
    }
    .social-card h3 {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
    }
    .social-card p {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* Milestones Grid */
    .milestones-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
    @media (max-width: 768px) {
      .milestones-grid {
        grid-template-columns: 1fr;
      }
    }
    .milestone-card {
      padding: 2rem;
      background: #ffffff;
    }
    .m-card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    .m-badge {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--primary);
      background: var(--primary-subtle);
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius-sm);
    }
    .m-emoji {
      font-size: 1.4rem;
    }
    .m-heading {
      font-size: 1.15rem;
      margin-bottom: 0.5rem;
    }
    .m-body {
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* CTA Bar */
    .about-cta-bar {
      background: linear-gradient(135deg, #0b1120 0%, #1e3a8a 100%);
      color: #ffffff;
      padding: 3.5rem 0;
    }
    .cta-flex {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
      flex-wrap: wrap;
    }
    .about-cta-bar h2 {
      font-size: 1.6rem;
      color: #ffffff;
      margin-bottom: 0.35rem;
    }
    .about-cta-bar p {
      color: #93c5fd;
    }
    .cta-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }
  </style>
</Layout>