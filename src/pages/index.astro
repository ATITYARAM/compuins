<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('enquiry-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        // 1. Grab the values using the exact IDs in your HTML
        const name = document.getElementById('name').value.trim() || 'N/A';
        const org = document.getElementById('org').value.trim() || 'N/A';
        const phone = document.getElementById('phone').value.trim() || 'N/A';
        const service = document.getElementById('service').value || 'Not specified';
        const message = document.getElementById('message').value.trim() || 'No message provided';

        // 2. Configure the email
        const recipient = 'contact@compuins.com';
        const subject = encodeURIComponent('ENQUIRY');

        const bodyText = 
          `Hello Computer Instruments,\n\n` +
          `Here are the details of my enquiry:\n\n` +
          `• Name: ${name}\n` +
          `• Organisation: ${org}\n` +
          `• Phone Number: ${phone}\n` +
          `• Service Required: ${service}\n\n` +
          `• Message:\n${message}\n\n` +
          `Regards,\n${name}`;

        // 3. Trigger the mailto link
        window.location.href = `mailto:${recipient}?subject=${subject}&body=${encodeURIComponent(bodyText)}`;

        // 4. Show the "Thank you" message and clear the form
        const thanks = document.getElementById('form-thanks');
        if (thanks) thanks.style.display = 'block';
        e.target.reset();
      });
    }
  });
</script>
