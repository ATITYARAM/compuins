---
import Layout from '../layouts/Layout.astro';
import company from '../data/company.json';
import { getProducts } from '../lib/products';

const base = import.meta.env.BASE_URL;
const products = getProducts();
const title = 'Hardware & Workstation Products';
---

<Layout
  title={`${title} | ${company.name}`}
  description="Explore Computer Instruments' inventory of custom Intel Core workstations, commercial desktop PCs, servers, and hardware peripherals in Ramanathapuram."
>
  <!-- Page Header -->
  <section class="products-hero">
    <div class="container">
      <div class="products-hero-content">
        <a href={base} class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
          <span>Back to Overview</span>
        </a>
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>HARDWARE INVENTORY &amp; WORKSTATION BUILDS</span>
        </div>
        <h1 class="products-title">Hardware &amp; Workstations</h1>
        <p class="products-subtitle">
          Commercial desktop computers, high-performance Intel workstations, printers, and OEM accessories supplied with comprehensive on-site warranty in Ramanathapuram.
        </p>
      </div>
    </div>
  </section>

  <!-- Products Catalog Section -->
  <section class="section catalog-section">
    <div class="container">
      <div class="catalog-header-bar">
        <div>
          <h2 class="catalog-heading">Available Hardware Archives</h2>
          <p class="catalog-subheading">Hardware bundles dynamically processed from verified institutional inventory.</p>
        </div>
        <div class="catalog-count-pill">
          <span>{products.length} Products Found</span>
        </div>
      </div>

      {products.length > 0 ? (
        <div class="products-grid">
          {products.map((product, index) => (
            <article class="product-item-card card-interactive">
              <div class="product-thumbnail-box">
                {product.thumbnail ? (
                  <img
                    src={product.thumbnail}
                    alt={`${product.title} product preview`}
                    class="product-img"
                    loading={index < 4 ? 'eager' : 'lazy'}
                  />
                ) : (
                  <div class="thumbnail-placeholder">
                    <div class="placeholder-icon">🖥️</div>
                    <span class="placeholder-brand">CI HARDWARE</span>
                    <small>Image in Archive</small>
                  </div>
                )}
                <span class="item-number-badge">#{String(index + 1).padStart(2, '0')}</span>
              </div>

              <div class="product-info-box">
                <div class="product-tag-row">
                  <span class="stock-pill">Verified In-Stock</span>
                  <span class="warranty-pill">On-Site Warranty</span>
                </div>

                <h3 class="product-name">{product.title}</h3>
                <p class="product-summary">
                  Enterprise-grade build tested and validated for 24/7 institutional uptime, data entry centers, and office automation.
                </p>

                <div class="product-actions-wrap">
                  <a
                    href={`https://wa.me/${company.whatsapp}?text=${encodeURIComponent(`Hello Computer Instruments, I would like to inquire about the pricing and availability of: ${product.title}`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary btn-product-action"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.456 5.711 1.458h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    <span>Enquire on WhatsApp</span>
                  </a>
                  <a href={`tel:${company.phone}`} class="btn btn-secondary btn-icon-only" aria-label="Call about this product">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state-panel card-interactive">
          <div class="empty-icon">📦</div>
          <h3>Inventory Archive Updating</h3>
          <p>
            Add a product archive <code>.zip</code> file to the repository's <code>Products/</code> directory. Each ZIP should contain hardware specs and a <code>thumbnail.jpg</code> or <code>thumbnail.png</code>.
          </p>
          <a href={`${base}#contact`} class="btn btn-primary">Contact Hardware Desk</a>
        </div>
      )}
    </div>
  </section>

  <style>
    .products-hero {
      background: linear-gradient(135deg, #070b14 0%, #0b1120 50%, #101c38 100%);
      color: #ffffff;
      padding: 5rem 0 4rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: #93c5fd;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      transition: color var(--transition-fast);
    }
    .back-link:hover {
      color: #ffffff;
      transform: translateX(-3px);
    }
    .products-title {
      font-size: clamp(2.4rem, 4.5vw, 3.6rem);
      color: #ffffff;
      margin: 1rem 0;
      line-height: 1.1;
    }
    .products-subtitle {
      font-size: 1.1rem;
      color: #cbd5e1;
      max-width: 65ch;
      line-height: 1.65;
    }

    .catalog-section {
      background: #f8fafc;
    }
    .catalog-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1.5rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .catalog-heading {
      font-size: 1.75rem;
      color: var(--text-main);
      margin-bottom: 0.35rem;
    }
    .catalog-subheading {
      font-size: 0.95rem;
      color: var(--text-muted);
    }
    .catalog-count-pill {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--primary);
      background: var(--primary-subtle);
      border: 1px solid rgba(59, 130, 246, 0.25);
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-full);
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
    @media (max-width: 1024px) {
      .products-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 640px) {
      .products-grid {
        grid-template-columns: 1fr;
      }
    }

    .product-item-card {
      background: #ffffff;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .product-thumbnail-box {
      aspect-ratio: 16 / 10;
      background: var(--slate-100);
      position: relative;
      overflow: hidden;
    }
    .product-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .product-item-card:hover .product-img {
      transform: scale(1.05);
    }
    .thumbnail-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
      color: #ffffff;
      gap: 0.25rem;
    }
    .placeholder-icon {
      font-size: 2rem;
    }
    .placeholder-brand {
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: #38bdf8;
    }
    .placeholder-placeholder small {
      font-size: 0.75rem;
      color: #94a3b8;
    }
    .item-number-badge {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(11, 17, 32, 0.75);
      backdrop-filter: blur(6px);
      color: #ffffff;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.2rem 0.5rem;
      border-radius: var(--radius-sm);
    }

    .product-info-box {
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      justify-content: space-between;
    }
    .product-tag-row {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 0.75rem;
      flex-wrap: wrap;
    }
    .stock-pill {
      font-size: 0.7rem;
      font-weight: 700;
      color: #059669;
      background: #ecfdf5;
      padding: 0.15rem 0.5rem;
      border-radius: var(--radius-full);
    }
    .warranty-pill {
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--primary);
      background: var(--primary-subtle);
      padding: 0.15rem 0.5rem;
      border-radius: var(--radius-full);
    }
    .product-name {
      font-size: 1.25rem;
      color: var(--text-main);
      margin-bottom: 0.5rem;
    }
    .product-summary {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.55;
      margin-bottom: 1.5rem;
    }
    .product-actions-wrap {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }
    .btn-product-action {
      flex-grow: 1;
      font-size: 0.85rem;
      padding: 0.65rem 1rem;
    }
    .btn-icon-only {
      padding: 0.65rem;
    }

    /* Empty State */
    .empty-state-panel {
      padding: 4rem 2rem;
      text-align: center;
      background: #ffffff;
      max-width: 600px;
      margin: 0 auto;
    }
    .empty-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
    }
    .empty-state-panel h3 {
      font-size: 1.4rem;
      margin-bottom: 0.5rem;
    }
    .empty-state-panel p {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
      line-height: 1.6;
    }
  </style>
</Layout>
