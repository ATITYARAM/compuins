---
import company from '../data/company.json';
import navigation from '../data/navigation.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${company.name} | Ramanathapuram's Pioneer IT Institution Since 1994`,
  description = "Computer Instruments (est. 1994) offers enterprise hardware sales, AMC, government data entry, census projects, and computer education across Ramanathapuram district."
} = Astro.props;

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg?v=3`} />
    <link rel="alternate icon" href={`${base}favicon.ico`} />
    <meta name="theme-color" content="#0b1120" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <!-- Top Institutional Announcement Bar -->
    <aside class="top-bar" aria-label="Announcement bar">
      <div class="container top-bar-inner">
        <div class="top-bar-left">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span><strong>Serving Ramanathapuram District Since 1994</strong> — 30+ Years of Institutional &amp; Government IT Trust</span>
        </div>
        <div class="top-bar-right">
          <a href={`tel:${company.phone}`} class="top-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span>Direct Desk: +91 {company.phoneDisplay}</span>
          </a>
          <span class="divider">|</span>
          <a href={`mailto:${company.email}`} class="top-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span>{company.email}</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Navigation Header -->
    <header class="main-header" id="main-header">
      <div class="container header-inner">
        <a href={base} class="brand-link" aria-label="Computer Instruments Homepage">
          <div class="ci-symbol">
            <span class="ci-letters">CI</span>
          </div>
          <div class="brand-text">
            <div class="brand-name">
              <span class="name-bold">COMPUTER</span>
              <span class="name-accent">INSTRUMENTS</span>
            </div>
            <div class="brand-sub">
              <span>{company.historicalName}</span>
              <span class="sub-sep">•</span>
              <span>Est. {company.foundedYear}</span>
            </div>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="desktop-nav" aria-label="Primary Navigation">
          <ul class="nav-list">
            <li><a href={`${base}`} class="nav-item">Home</a></li>
            <li><a href={`${base}#services`} class="nav-item">Services</a></li>
            <li><a href={`${base}#legacy`} class="nav-item">Legacy</a></li>
            <li><a href={`${base}#projects`} class="nav-item">Projects</a></li>
            <li><a href={`${base}#endorsements`} class="nav-item">Recognition</a></li>
            <li><a href={`${base}#infra`} class="nav-item">Infrastructure</a></li>
            <li><a href={`${base}products/`} class={`nav-item ${currentPath.includes('products') ? 'active' : ''}`}>Products</a></li>
            <li><a href={`${base}about/`} class={`nav-item ${currentPath.includes('about') ? 'active' : ''}`}>About</a></li>
          </ul>
        </nav>

        <!-- Header Actions -->
        <div class="header-actions">
          <a href={`${base}#contact`} class="btn btn-primary btn-sm">
            <span>Enquire Now</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          <!-- Mobile Menu Trigger -->
          <button id="mobile-toggle" class="mobile-toggle-btn" aria-label="Open mobile navigation menu" aria-expanded="false">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
        <div class="mobile-drawer-inner">
          <nav aria-label="Mobile Navigation">
            <ul class="mobile-nav-list">
              <li><a href={`${base}`} class="mobile-nav-link">Home</a></li>
              <li><a href={`${base}#services`} class="mobile-nav-link">Services &amp; AMC</a></li>
              <li><a href={`${base}#legacy`} class="mobile-nav-link">Three Decades Legacy</a></li>
              <li><a href={`${base}#projects`} class="mobile-nav-link">Government Projects</a></li>
              <li><a href={`${base}#endorsements`} class="mobile-nav-link">IAS Recognition</a></li>
              <li><a href={`${base}#infra`} class="mobile-nav-link">Infrastructure &amp; Team</a></li>
              <li><a href={`${base}products/`} class="mobile-nav-link">Products Catalog</a></li>
              <li><a href={`${base}about/`} class="mobile-nav-link">About Us</a></li>
              <li><a href={`${base}#contact`} class="mobile-nav-link contact-highlight">Contact &amp; Proposal</a></li>
            </ul>
          </nav>
          <div class="mobile-contact-card">
            <p class="m-title">Direct Inquiries</p>
            <a href={`tel:${company.phone}`} class="m-phone">📞 {company.phoneDisplay}</a>
            <p class="m-address">{company.address.line1}, {company.address.city}</p>
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Master Institutional Footer -->
    <footer class="site-footer">
      <div class="footer-top">
        <div class="container footer-grid">
          <!-- Col 1: Brand & Heritage -->
          <div class="footer-col brand-col">
            <div class="footer-logo">
              <div class="ci-symbol small">
                <span>CI</span>
              </div>
              <div>
                <strong class="f-title">{company.name}</strong>
                <p class="f-sub">{company.historicalName}</p>
              </div>
            </div>
            <p class="f-tamil">{company.tamilName}</p>
            <p class="f-motto">“{company.motto}”</p>
            <p class="f-text">
              Proprietorship registered in {company.registeredYear} (Promoted as Computer Informatics on 12 June 1994). Dedicated to IT sales, public sector data digitization, and manpower excellence.
            </p>
            <div class="f-proprietor-badge">
              <span class="badge-role">Proprietor:</span>
              <span class="badge-name">{company.proprietor}</span>
            </div>
          </div>

          <!-- Col 2: Services & Solutions -->
          <div class="footer-col">
            <h3 class="footer-heading">Service Divisions</h3>
            <ul class="footer-links">
              <li><a href={`${base}#services`}>Enterprise Hardware &amp; AMC</a></li>
              <li><a href={`${base}#services`}>Data Entry &amp; Document Digitization</a></li>
              <li><a href={`${base}#services`}>IT Manpower Outsourcing</a></li>
              <li><a href={`${base}#services`}>Custom Healthcare &amp; Retail Software</a></li>
              <li><a href={`${base}#services`}>Hardware Assembly &amp; Training</a></li>
              <li><a href={`${base}products/`}>Products &amp; Components Catalog</a></li>
            </ul>
          </div>

          <!-- Col 3: Milestones & Quick Links -->
          <div class="footer-col">
            <h3 class="footer-heading">Institutional Legacy</h3>
            <ul class="footer-links">
              <li><a href={`${base}#legacy`}>1994 Founding Milestone</a></li>
              <li><a href={`${base}#legacy`}>1998 First Internet in District</a></li>
              <li><a href={`${base}#projects`}>BEL MNIC Biometric Project</a></li>
              <li><a href={`${base}#projects`}>Sarva Shiksha Abhiyan (2,000+ Students)</a></li>
              <li><a href={`${base}#endorsements`}>Letters of Appreciation (IAS / IPS)</a></li>
              <li><a href={`${base}about/`}>About Institution &amp; Social Impact</a></li>
            </ul>
          </div>

          <!-- Col 4: Contact & Statutory Compliance -->
          <div class="footer-col">
            <h3 class="footer-heading">Registered Office</h3>
            <address class="footer-address">
              <strong>Computer Instruments</strong><br />
              {company.address.line1}<br />
              {company.address.city} – {company.address.pincode}<br />
              {company.address.state}, India
            </address>
            <p class="footer-prev-address">
              <span>Historical Office (1998–2016):</span><br />
              {company.previousAddress.full}
            </p>
            
            <div class="footer-compliance">
              <span class="compliance-title">Statutory Compliance</span>
              <div class="compliance-tags">
                <span class="tag-pill">GST: {company.legalIds.gst}</span>
                <span class="tag-pill">PAN: {company.legalIds.pan}</span>
                <span class="tag-pill">TN VAT: {company.legalIds.tnVat}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer Bottom Strip -->
      <div class="footer-bottom">
        <div class="container footer-bottom-inner">
          <p>© {new Date().getFullYear()} {company.name}. All verified institutional records preserved.</p>
          <div class="footer-bottom-links">
            <a href={`${base}about/`}>Institutional Profile</a>
            <span>•</span>
            <a href={`${base}#projects`}>Public Sector Archives</a>
            <span>•</span>
            <a href={`${base}#contact`}>Service Desk</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Floating Interactive Action: WhatsApp Quick Connect -->
    <a
      href={`https://wa.me/${company.whatsapp}?text=${encodeURIComponent('Hello Computer Instruments, I would like to enquire about your IT services / AMC.')}`}
      class="whatsapp-fab"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Direct chat with Computer Instruments on WhatsApp"
    >
      <div class="whatsapp-icon-wrap">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.456 5.711 1.458h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </div>
      <span class="whatsapp-label">Chat on WhatsApp</span>
    </a>

    <!-- Floating Back to Top Button -->
    <button id="back-to-top" class="back-to-top" aria-label="Back to top">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
    </button>

    <script is:inline>
      // Header Scroll and Back-to-Top Logic
      const header = document.getElementById('main-header');
      const bttBtn = document.getElementById('back-to-top');

      window.addEventListener('scroll', () => {
        if (window.scrollY > 40) {
          header?.classList.add('scrolled');
        } else {
          header?.classList.remove('scrolled');
        }

        if (window.scrollY > 400) {
          bttBtn?.classList.add('visible');
        } else {
          bttBtn?.classList.remove('visible');
        }
      });

      bttBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // Mobile Menu Drawer Toggle
      const mobileToggle = document.getElementById('mobile-toggle');
      const mobileDrawer = document.getElementById('mobile-drawer');

      mobileToggle?.addEventListener('click', () => {
        const isExpanded = mobileToggle.getAttribute('aria-expanded') === 'true';
        mobileToggle.setAttribute('aria-expanded', String(!isExpanded));
        mobileToggle.classList.toggle('active');
        mobileDrawer?.classList.toggle('open');
      });

      // Close mobile drawer when link clicked
      const mobileLinks = document.querySelectorAll('.mobile-nav-link');
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileToggle?.setAttribute('aria-expanded', 'false');
          mobileToggle?.classList.remove('active');
          mobileDrawer?.classList.remove('open');
        });
      });
    </script>

    <style>
      /* Top Institutional Announcement Bar */
      .top-bar {
        background: #060a12;
        color: #94a3b8;
        font-size: 0.78rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding: 0.45rem 0;
        position: relative;
        z-index: 101;
      }
      .top-bar-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }
      .top-bar-left {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .top-bar-left strong {
        color: #f8fafc;
      }
      .top-bar-right {
        display: flex;
        align-items: center;
        gap: 0.85rem;
      }
      .top-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: #cbd5e1;
        transition: color var(--transition-fast);
      }
      .top-link:hover {
        color: #38bdf8;
      }
      .divider {
        color: #334155;
      }

      /* Main Navigation Header */
      .main-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(226, 232, 240, 0.8);
        transition: all var(--transition-normal);
      }
      .main-header.scrolled {
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 10px 25px -5px rgba(11, 17, 32, 0.06);
        border-bottom-color: rgba(203, 213, 225, 0.8);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.85rem 1.5rem;
      }

      /* Brand Symbol & Monogram */
      .brand-link {
        display: flex;
        align-items: center;
        gap: 0.85rem;
      }
      .ci-symbol {
        width: 44px;
        height: 44px;
        border-radius: var(--radius-md);
        background: linear-gradient(135deg, #0b1120 0%, #1e3a8a 100%);
        border: 1.5px solid rgba(59, 130, 246, 0.4);
        box-shadow: 0 4px 12px rgba(29, 78, 216, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        flex-shrink: 0;
      }
      .ci-symbol.small {
        width: 38px;
        height: 38px;
        font-size: 1rem;
      }
      .brand-text {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
      }
      .brand-name {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .name-bold {
        color: var(--text-main);
      }
      .name-accent {
        color: var(--primary);
        margin-left: 0.25rem;
      }
      .brand-sub {
        font-size: 0.72rem;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-weight: 500;
      }
      .sub-sep {
        opacity: 0.5;
      }

      /* Desktop Nav */
      .desktop-nav {
        display: flex;
        align-items: center;
      }
      .nav-list {
        display: flex;
        list-style: none;
        align-items: center;
        gap: 0.4rem;
      }
      .nav-item {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text-body);
        padding: 0.45rem 0.85rem;
        border-radius: var(--radius-sm);
        transition: all var(--transition-fast);
      }
      .nav-item:hover {
        color: var(--primary);
        background: var(--primary-subtle);
      }
      .nav-item.active {
        color: var(--primary);
        background: var(--primary-subtle);
        font-weight: 700;
      }

      /* Header Actions */
      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .btn-sm {
        padding: 0.55rem 1.1rem;
        font-size: 0.85rem;
      }

      /* Mobile Hamburger Button */
      .mobile-toggle-btn {
        display: none;
        flex-direction: column;
        justify-content: space-between;
        width: 32px;
        height: 24px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 2px 0;
      }
      .hamburger-line {
        width: 100%;
        height: 2.5px;
        background: var(--text-main);
        border-radius: 2px;
        transition: all 0.2s ease-in-out;
      }
      .mobile-toggle-btn.active .hamburger-line:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }
      .mobile-toggle-btn.active .hamburger-line:nth-child(2) {
        opacity: 0;
      }
      .mobile-toggle-btn.active .hamburger-line:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }

      /* Mobile Drawer */
      .mobile-drawer {
        display: none;
      }
      @media (max-width: 992px) {
        .desktop-nav {
          display: none;
        }
        .mobile-toggle-btn {
          display: flex;
        }
        .top-bar-right {
          display: none;
        }
        .mobile-drawer {
          display: block;
          max-height: 0;
          overflow: hidden;
          background: #ffffff;
          border-top: 1px solid var(--border-light);
          transition: max-height 0.35s ease;
        }
        .mobile-drawer.open {
          max-height: 600px;
          box-shadow: 0 16px 24px -6px rgba(0, 0, 0, 0.1);
        }
        .mobile-drawer-inner {
          padding: 1.25rem 1.5rem 2rem;
        }
        .mobile-nav-list {
          list-style: none;
          display: flex;
          flex-direction: column;
          gap: 0.25rem;
        }
        .mobile-nav-link {
          display: block;
          padding: 0.65rem 0.5rem;
          font-size: 0.95rem;
          font-weight: 600;
          color: var(--text-main);
          border-radius: var(--radius-sm);
        }
        .mobile-nav-link:hover {
          color: var(--primary);
          background: var(--primary-subtle);
        }
        .contact-highlight {
          color: var(--primary);
          background: var(--primary-subtle);
          margin-top: 0.5rem;
        }
        .mobile-contact-card {
          margin-top: 1.5rem;
          padding: 1rem;
          background: var(--slate-50);
          border: 1px solid var(--border-light);
          border-radius: var(--radius-md);
        }
        .m-title {
          font-size: 0.75rem;
          text-transform: uppercase;
          letter-spacing: 0.08em;
          color: var(--text-muted);
          margin-bottom: 0.25rem;
        }
        .m-phone {
          font-weight: 700;
          color: var(--primary);
          font-size: 1rem;
          display: block;
          margin-bottom: 0.25rem;
        }
        .m-address {
          font-size: 0.8rem;
          color: var(--text-muted);
        }
      }

      /* Site Footer */
      .site-footer {
        background: #080d1a;
        color: #94a3b8;
        padding-top: 5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }
      .footer-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
        gap: 3.5rem;
        padding-bottom: 4rem;
      }
      @media (max-width: 1024px) {
        .footer-grid {
          grid-template-columns: 1fr 1fr;
          gap: 2.5rem;
        }
      }
      @media (max-width: 640px) {
        .footer-grid {
          grid-template-columns: 1fr;
          gap: 2.5rem;
        }
      }
      .footer-logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
      }
      .f-title {
        color: #f8fafc;
        font-size: 1.1rem;
        display: block;
      }
      .f-sub {
        font-size: 0.78rem;
        color: #64748b;
      }
      .f-tamil {
        font-size: 0.95rem;
        color: #38bdf8;
        margin-bottom: 0.35rem;
      }
      .f-motto {
        font-style: italic;
        font-size: 0.85rem;
        color: #fbbf24;
        margin-bottom: 1rem;
      }
      .f-text {
        font-size: 0.85rem;
        line-height: 1.6;
        color: #94a3b8;
        margin-bottom: 1.25rem;
      }
      .f-proprietor-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.35rem 0.75rem;
        border-radius: var(--radius-sm);
        font-size: 0.78rem;
      }
      .badge-role {
