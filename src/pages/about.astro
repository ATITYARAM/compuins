---
import Layout from '../layouts/Layout.astro';
import legacy from '../data/legacy.json';
---

<Layout title="About Us">
  <div class="page-header">
    <h1>Our Legacy & Milestones</h1>
  </div>

  <section class="content-section">
    <div class="grid">
      {legacy.items.map(item => (
        <div class="floating-card">
          <h3>{item.date}: {item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </section>

  <style>
    .page-header { background: var(--dark-bg); color: white; padding: 4rem 2rem; text-align: center; }
    .content-section { padding: 4rem 5%; max-width: 1200px; margin: 0 auto; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 2rem; }
    h3 { color: var(--primary); margin-bottom: 1rem; }
  </style>
</Layout>